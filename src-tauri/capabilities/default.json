{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allow the main application commands, title bar controls and external HTTP(S) links.",
  "permissions": [
    "allow-identity-restore",
    "allow-identity-import",
    "allow-identity-create",
    "allow-identity-export",
    "allow-relay-sign",
    "allow-relay-http",
    "allow-get-os-idle-seconds",
    "allow-plugin-import-folder",
    "allow-plugin-import-git",
    "allow-plugin-import-install",
    "allow-plugin-import-discard",
    "allow-plugin-catalog",
    "allow-plugin-change",
    "allow-plugin-reload",
    "allow-plugin-module",
    "allow-plugin-recover",
    "allow-plugin-host-run-command",
    "allow-plugin-host-request",
    "allow-agent-control-create-prepare",
    "allow-agent-control-create-commit",
    "allow-agent-control-creation-profile",
    "allow-agent-control-snapshot",
    "allow-agent-control-log-challenge",
    "allow-agent-control-read-log",
    "allow-goose-install",
    "allow-pi-install",
    "allow-agent-control-save",
    "allow-agent-control-save-defaults",
    "allow-agent-control-start-on-app-launch",
    "allow-agent-control-delete",
    "allow-agent-control-action",
    "allow-agent-control-attach-mention",
    "allow-agent-control-import-preview",
    "allow-agent-control-import-commit",
    "allow-agent-control-local-clone-settings",
    "allow-agent-control-clone-settings",
    "allow-agent-control-use-here",
    "allow-agent-models-begin",
    "allow-agent-models-cancel",
    "allow-agent-models-run",
    "allow-title-bar-double-click",
    "allow-notification-show",
    "allow-dock-permission",
    "allow-unread-indicator-set",
    "allow-terminal-create-owner",
    "allow-terminal-spawn",
    "allow-terminal-read",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close",
    "allow-terminal-close-owner",
    "allow-browser-attach",
    "allow-browser-set-bounds",
    "allow-browser-detach",
    "allow-browser-navigate",
    "allow-browser-action",
    "allow-browser-status",
    "core:app:allow-version",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ],
  "webviews": ["main"]
}
